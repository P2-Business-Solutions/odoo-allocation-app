<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_apparel_allocation" model="ir.ui.view">
        <field name="name">res.config.settings.apparel.allocation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app settings="True" string="Apparel Allocation" name="apparel_allocation">
                    <h2>Allocation Defaults</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_apparel_product_variants"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_apparel_product_variants"/>
                                <div class="text-muted">
                                    When enabled, allocation rules evaluate individual
                                    product variants (e.g., sizes) by default. Individual
                                    rules can override this setting.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="apparel_default_incoming_days"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="apparel_default_incoming_days"/>
                                <div class="text-muted">
                                    Default number of days to look ahead for incoming
                                    stock when computing availability and running the
                                    allocation engine. Individual rules can override
                                    this value. Set to 0 for no limit on rule checks.
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Supply Sources</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="apparel_allocate_from_po"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="apparel_allocate_from_po"/>
                                <div class="text-muted">
                                    Allow allocating sale order demand against confirmed
                                    purchase orders (future inventory).
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="apparel_allocate_from_mo"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="apparel_allocate_from_mo"/>
                                <div class="text-muted">
                                    Allow allocating sale order demand against confirmed
                                    manufacturing orders (future inventory).
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Date Matching &amp; Automation</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="apparel_enforce_date_match"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="apparel_enforce_date_match"/>
                                <div class="text-muted">
                                    Only allocate future supply expected on or before the
                                    order's commitment date (plus the tolerance below).
                                </div>
                                <div class="mt8" invisible="not apparel_enforce_date_match">
                                    <label for="apparel_date_tolerance_days" class="me-2"/>
                                    <field name="apparel_date_tolerance_days" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="apparel_auto_allocate_on_confirm"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="apparel_auto_allocate_on_confirm"/>
                                <div class="text-muted">
                                    Automatically run the allocation engine with these
                                    defaults whenever a sale order is confirmed.
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
